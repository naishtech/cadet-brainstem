{
  "name": "cadet-token-saver",
  "version": "0.1.20",
  "description": "Cadet Token Saver — an orchestration + measurement layer that reduces AI-agent context consumption.",
  "keywords": [
    "cli",
    "ai",
    "context",
    "tokens",
    "optimization",
    "agent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/naishtech/cadet-token-saver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naishtech/cadet-token-saver.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "cadet-token-saver": "bin/cadet-token-saver.cjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts --max-warnings 0",
    "classify:smoke": "tsx scripts/classify-smoke.ts",
    "benchmark:shell": "tsx scripts/benchmark-shell-compression.ts",
    "mcp:smoke": "npm run build && tsx scripts/mcp-classify-e2e.ts",
    "postinstall": "node -e \"console.log('cadet-token-saver v' + (process.env.npm_package_version || 'unknown') + ' installed')\"",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mustache": "^4.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
