{
  "name": "cadet-brainstem",
  "version": "0.3.10",
  "description": "Cadet Brainstem — an orchestration + measurement layer that reduces AI-agent context consumption.",
  "keywords": [
    "cli",
    "ai",
    "context",
    "tokens",
    "optimization",
    "agent"
  ],
  "license": "MIT",
  "homepage": "https://github.com/naishtech/cadet-brainstem#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naishtech/cadet-brainstem.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "cadet-brainstem": "bin/cadet-brainstem.cjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "scripts/install-hooks.cjs",
    "scripts/install-leanctx.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/copy-web-static.cjs",
    "build:all": "npm --prefix web ci && npm --prefix web run build && npm run build",
    "dev": "tsup --watch",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts --max-warnings 0",
    "steer:smoke": "tsx scripts/steer-smoke.ts",
    "smoke:llm-trace": "tsx scripts/llm-trace-smoke.ts",
    "seed:procedures": "tsx scripts/seed-procedures.ts",
    "smoke:procedures": "tsx scripts/procedure-matcher-smoke.ts",
    "e2e:agent-loop": "tsx scripts/agent-loop-write-e2e.ts",
    "mcp:smoke": "npm run build && tsx scripts/mcp-steer-e2e.ts",
    "postinstall": "node scripts/install-hooks.cjs && node scripts/install-leanctx.cjs",
    "release": "bash scripts/bump-version.sh patch && npm publish",
    "prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mustache": "^4.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
